+package main
+
+import (
+	"bytes"
+	"encoding/base64"
+	"encoding/json"
+	"image"
+	"image/png"
+	"sync"
+)
+
+const maximumCursorDimension = 256
+
+type cursorImage struct {
+	width, height      int
+	hotspotX, hotspotY int
+	pixels             []byte
+}
+
+type cursorMessage struct {
+	Type     string `json:"type"`
+	Visible  bool   `json:"visible"`
+	Width    int    `json:"width"`
+	Height   int    `json:"height"`
+	HotspotX int    `json:"hotspotX"`
+	HotspotY int    `json:"hotspotY"`
+	Image    string `json:"image"`
+}
+
+type cursorBridge struct {
+	mu     sync.Mutex
+	state  cursorMessage
+	latest []byte
+	sink   chan []byte
+}
+
+func newCursorBridge() *cursorBridge {
+	bridge := &cursorBridge{}
+	bridge.reset()
+	return bridge
+}
+
+func (bridge *cursorBridge) reset() {
+	bridge.mu.Lock()
+	bridge.state = cursorMessage{Type: "cursor", Visible: true}
+	bridge.rebuildLocked()
+	bridge.mu.Unlock()
+}
+
+func (bridge *cursorBridge) publishImage(value cursorImage) error {
+	rgba := image.NewRGBA(image.Rect(0, 0, value.width, value.height))
+	for offset := 0; offset < len(value.pixels); offset += 4 {
+		rgba.Pix[offset] = value.pixels[offset+2]
+		rgba.Pix[offset+1] = value.pixels[offset+1]
+		rgba.Pix[offset+2] = value.pixels[offset]
+		rgba.Pix[offset+3] = value.pixels[offset+3]
+	}
+	var encoded bytes.Buffer
+	if err := png.Encode(&encoded, rgba); err != nil {
+		return err
+	}
+
+	bridge.mu.Lock()
+	bridge.state.Width = value.width
+	bridge.state.Height = value.height
+	bridge.state.HotspotX = value.hotspotX
+	bridge.state.HotspotY = value.hotspotY
+	bridge.state.Image = "data:image/png;base64," + base64.StdEncoding.EncodeToString(encoded.Bytes())
+	bridge.rebuildLocked()
+	bridge.mu.Unlock()
+	return nil
+}
+
+func (bridge *cursorBridge) publishVisibility(visible bool) {
+	bridge.mu.Lock()
+	bridge.state.Visible = visible
+	bridge.rebuildLocked()
+	bridge.mu.Unlock()
+}
+
+func (bridge *cursorBridge) rebuildLocked() {
+	bridge.latest, _ = json.Marshal(bridge.state)
+	if bridge.sink != nil {
+		replaceQueued(bridge.sink, bridge.latest)
+	}
+}
+
+func (bridge *cursorBridge) attach(sink chan []byte) {
+	bridge.mu.Lock()
+	bridge.sink = sink
+	replaceQueued(sink, bridge.latest)
+	bridge.mu.Unlock()
+}
+
+func (bridge *cursorBridge) detach(sink chan []byte) {
+	bridge.mu.Lock()
+	if bridge.sink == sink {
+		bridge.sink = nil
+	}
+	bridge.mu.Unlock()
+}
