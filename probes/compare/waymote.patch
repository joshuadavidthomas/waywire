+
+func cursorStreamEvent(eventType byte, payload []byte) []byte {
+	event := make([]byte, streamEventHeaderSize+len(payload))
+	event[0] = protocolVersion
+	event[1] = eventType
+	binary.LittleEndian.PutUint32(event[4:8], uint32(len(payload)))
+	copy(event[streamEventHeaderSize:], payload)
+	return event
+}
+
+func receiveCursorTestEvents(input []byte, image func(cursorImage) error, visibility func(bool)) error {
+	return receiveStreamEvents(bytes.NewReader(input), func([]byte) {}, func(frameMetadata) error { return nil }, func([]byte) {}, image, visibility)
+}
+
+func TestReceiveStreamCursorEvents(t *testing.T) {
+	payload := make([]byte, 20)
+	binary.LittleEndian.PutUint32(payload[0:4], 1)
+	binary.LittleEndian.PutUint32(payload[4:8], 1)
+	binary.LittleEndian.PutUint32(payload[8:12], ^uint32(6))
+	binary.LittleEndian.PutUint32(payload[12:16], 9)
+	copy(payload[16:], []byte{11, 22, 33, 44})
+	stream := append(cursorStreamEvent(streamCursorImage, payload), cursorStreamEvent(streamCursorVisibility, []byte{1})...)
+
+	var got cursorImage
+	visible := false
+	err := receiveCursorTestEvents(stream, func(value cursorImage) error {
+		got = value
+		return nil
+	}, func(value bool) { visible = value })
+	if !errors.Is(err, io.EOF) {
+		t.Fatalf("receiveStreamEvents() error = %v, want EOF", err)
+	}
+	if got.width != 1 || got.height != 1 || got.hotspotX != -7 || got.hotspotY != 9 ||
+		!bytes.Equal(got.pixels, []byte{11, 22, 33, 44}) || !visible {
+		t.Fatalf("unexpected cursor events: image=%+v visible=%t", got, visible)
+	}
+}
+
+func TestReceiveStreamRejectsMalformedCursorEvents(t *testing.T) {
+	validImage := make([]byte, 20)
+	binary.LittleEndian.PutUint32(validImage[0:4], 1)
+	binary.LittleEndian.PutUint32(validImage[4:8], 1)
+	oversized := make([]byte, 16)
+	binary.LittleEndian.PutUint32(oversized[0:4], maximumCursorDimension+1)
+	binary.LittleEndian.PutUint32(oversized[4:8], 1)
+	tooLargeHeader := make([]byte, streamEventHeaderSize)
+	tooLargeHeader[0] = protocolVersion
+	tooLargeHeader[1] = streamCursorImage
+	binary.LittleEndian.PutUint32(tooLargeHeader[4:8], maximumClipboardBytes+1)
+	truncatedPayload := cursorStreamEvent(streamCursorImage, validImage)
+	truncatedPayload = truncatedPayload[:len(truncatedPayload)-1]
+
+	tests := map[string][]byte{
+		"truncated header":     {protocolVersion, streamCursorImage},
+		"truncated payload":    truncatedPayload,
+		"short shape":          cursorStreamEvent(streamCursorImage, make([]byte, 15)),
+		"wrong pixel count":    cursorStreamEvent(streamCursorImage, validImage[:16]),
+		"oversized dimensions": cursorStreamEvent(streamCursorImage, oversized),
+		"oversized frame":      tooLargeHeader,
+		"empty visibility":     cursorStreamEvent(streamCursorVisibility, nil),
+		"long visibility":      cursorStreamEvent(streamCursorVisibility, []byte{1, 0}),
+		"bad visibility":       cursorStreamEvent(streamCursorVisibility, []byte{2}),
+	}
+	for name, input := range tests {
+		t.Run(name, func(t *testing.T) {
+			if err := receiveCursorTestEvents(input, func(cursorImage) error { return nil }, func(bool) {}); err == nil {
+				t.Fatal("malformed cursor event accepted")
+			}
+		})
+	}
+}
+
+func TestCursorBridgeEncodesPremultipliedBGRAAsPNG(t *testing.T) {
+	bridge := newCursorBridge()
+	if err := bridge.publishImage(cursorImage{
+		width: 1, height: 1, hotspotX: -2, hotspotY: 3,
+		pixels: []byte{16, 32, 64, 128},
+	}); err != nil {
+		t.Fatal(err)
+	}
+	updates := make(chan []byte, 1)
+	bridge.attach(updates)
+	defer bridge.detach(updates)
+	message := decodeCursorMessage(t, <-updates)
+	if message.Type != "cursor" || !message.Visible || message.Width != 1 || message.Height != 1 ||
+		message.HotspotX != -2 || message.HotspotY != 3 || !strings.HasPrefix(message.Image, "data:image/png;base64,") {
+		t.Fatalf("unexpected cursor message: %+v", message)
+	}
+	encoded, err := base64.StdEncoding.DecodeString(strings.TrimPrefix(message.Image, "data:image/png;base64,"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	decoded, err := png.Decode(bytes.NewReader(encoded))
+	if err != nil {
+		t.Fatal(err)
+	}
+	pixel := color.NRGBAModel.Convert(decoded.At(0, 0)).(color.NRGBA)
+	if pixel != (color.NRGBA{R: 127, G: 63, B: 31, A: 128}) {
+		t.Fatalf("decoded NRGBA = %+v", pixel)
+	}
+}
+
+func TestCursorBridgeCachesCombinedStateAndReplacesQueuedUpdate(t *testing.T) {
+	bridge := newCursorBridge()
+	if err := bridge.publishImage(cursorImage{width: 1, height: 1, hotspotX: -4, hotspotY: 5, pixels: []byte{0, 0, 0, 0}}); err != nil {
+		t.Fatal(err)
+	}
+	bridge.publishVisibility(false)
+	updates := make(chan []byte, 1)
+	bridge.attach(updates)
+	bridge.publishVisibility(true)
+	message := decodeCursorMessage(t, <-updates)
+	if !message.Visible || message.Width != 1 || message.Height != 1 || message.HotspotX != -4 || message.HotspotY != 5 || message.Image == "" {
+		t.Fatalf("replacement lost combined cursor state: %+v", message)
+	}
+	bridge.detach(updates)
+
+	bridge.reset()
+	resetUpdates := make(chan []byte, 1)
+	bridge.attach(resetUpdates)
+	defer bridge.detach(resetUpdates)
+	reset := decodeCursorMessage(t, <-resetUpdates)
+	if !reset.Visible || reset.Width != 0 || reset.Height != 0 || reset.HotspotX != 0 || reset.HotspotY != 0 || reset.Image != "" {
+		t.Fatalf("unexpected reset cursor: %+v", reset)
+	}
+}
+
+func decodeCursorMessage(t *testing.T, data []byte) cursorMessage {
+	t.Helper()
+	var message cursorMessage
+	if err := json.Unmarshal(data, &message); err != nil {
+		t.Fatal(err)
+	}
+	return message
+}
