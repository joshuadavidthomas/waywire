#!/usr/bin/env bash
set -euo pipefail

# Development dependencies for this orb, not an end-user installation contract.
cd "$(dirname "${BASH_SOURCE[0]}")/.."

step() {
  local label="$1" started=$SECONDS
  shift
  printf '\n==> %s\n' "$label"
  "$@"
  printf '==> %s finished in %ss\n' "$label" "$((SECONDS - started))"
}

system_dependencies() {
  local package
  local missing=()
  for package in build-essential ca-certificates curl pkg-config libpixman-1-dev libxkbcommon-dev python3 shellcheck ffmpeg dbus foot fonts-dejavu-core \
    xz-utils bzip2 meson ninja-build python3-jinja2 python3-attr libwayland-dev libx11-dev libxkbfile-dev libxfont-dev libxcvt-dev libdrm-dev libssl-dev libtirpc-dev libxshmfence-dev xtrans-dev x11proto-dev x11-xkb-utils xkb-data; do
    if [[ "$(dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true)" != 'install ok installed' ]]; then
      missing+=("$package")
    fi
  done
  if ((${#missing[@]})); then
    sudo env DEBIAN_FRONTEND=noninteractive apt-get update
    sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}"
  fi
}

# Keep build paths and cleanup scoped to Xwayland, not the rest of setup.
xwayland() (
  prefix="${WAYWIRE_XWAYLAND_PREFIX:-$HOME/.local/share/waywire-xwayland}"
  if [[ -x "$prefix/bin/Xwayland" ]] && "$prefix/bin/Xwayland" -version 2>&1 | grep -Fq 'Xwayland Version 24.1.13'; then
    printf 'CPU-only Xwayland is already installed in %s\n' "$prefix"
    exit 0
  fi
  work=$(mktemp -d)
  trap 'rm -rf "$work"' EXIT
  export PKG_CONFIG_PATH="$prefix/lib/pkgconfig:$prefix/share/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"

  fetch() {
    local url=$1 archive=$2 checksum=$3
    curl --fail --location --retry 3 "$url" -o "$work/$archive"
    echo "$checksum  $work/$archive" | sha256sum --check --status
    tar -xf "$work/$archive" -C "$work"
  }

  fetch https://deb.debian.org/debian/pool/main/libe/libei/libei_1.5.0.orig.tar.bz2 libei.tar.bz2 da1fba92daccd0667bc46c3ee952d4ae8cfc6bdb4c0bb4d34df26528fb240618
  fetch https://deb.debian.org/debian/pool/main/w/wayland-protocols/wayland-protocols_1.47.orig.tar.xz protocols.tar.xz 5fd4349bcbc9bab9a46f8cf77d1f434296a7a052c87440a094f63fcf62a58e20
  fetch https://www.x.org/releases/individual/proto/xorgproto-2024.1.tar.xz xorgproto.tar.xz 372225fd40815b8423547f5d890c5debc72e88b91088fbfb13158c20495ccb59
  fetch https://www.x.org/releases/individual/xserver/xwayland-24.1.13.tar.xz xwayland.tar.xz 173aea3d6f79609164c04528e1c8e4c9b60fcd59391c3c9dad4667297d727fb6

  build() {
    local source=$1
    shift
    # Debian's meson must find Debian's python modules, not an unrelated venv.
    PATH=/usr/bin:/bin meson setup "$work/$source-build" "$work/$source" --prefix="$prefix" --libdir=lib "$@"
    PATH=/usr/bin:/bin ninja -C "$work/$source-build" -j "${WAYWIRE_BUILD_JOBS:-4}" install
  }

  build libei-1.5.0 -Dtests=disabled -Dliboeffis=disabled -Dlibeis=disabled -Ddocumentation=[]
  build wayland-protocols-1.47 -Dtests=false
  build xorgproto-2024.1
  # Xwayland includes xf86drm.h even in the software-only build. No DRM device
  # or GL library is needed at runtime. Rpath survives Smithay's env_clear().
  export LDFLAGS="-Wl,-rpath,$prefix/lib"
  build xwayland-24.1.13 -Dglamor=false -Dglx=false -Ddrm=false -Ddri3=false \
    -Dxwayland_ei=socket -Dxvfb=false -Dlibdecor=false -Ddocs=false \
    -Ddevel-docs=false -Dxselinux=false -Dc_args=-I/usr/include/libdrm
  "$prefix/bin/Xwayland" -version
  printf 'Installed CPU-only Xwayland in %s/bin\n' "$prefix"
)

toolchains() {
  # Persist paths for subsequent Amp and service login shells, not just setup.
  local marker='# waywire orb toolchains'
  if ! grep -Fqx "$marker" "$HOME/.bash_profile" 2>/dev/null; then
    cat >> "$HOME/.bash_profile" <<'PROFILE'

# waywire orb toolchains
export PATH="$HOME/.local/share/waywire-node/node_modules/.bin:$HOME/.cargo/bin:$HOME/.local/bin:$PATH"
PROFILE
  fi
  export PATH="$HOME/.local/share/waywire-node/node_modules/.bin:$HOME/.cargo/bin:$HOME/.local/bin:$PATH"

  if ! command -v rustup >/dev/null; then
    curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs | bash -s -- -y --no-modify-path --default-toolchain none
  fi
  # rustup reads each directory's toolchain pin and installs missing components.
  cargo --version
  cargo clippy --version
  (cd tools/rustfmt && cargo fmt --version)

  if ! node -e 'process.exit(Number(process.versions.node.split(".")[0]) >= 26 ? 0 : 1)' 2>/dev/null; then
    npm install --prefix "$HOME/.local/share/waywire-node" --no-package-lock --no-audit --no-fund \
      "node@$(node -p 'require("./package.json").engines.node')"
  fi
  local pnpm_package
  pnpm_package="$(node -p 'require("./package.json").packageManager')"
  if [[ "$(pnpm --version 2>/dev/null || true)" != "${pnpm_package#pnpm@}" ]]; then
    npm install --prefix "$HOME/.local/share/waywire-node" --no-package-lock --no-audit --no-fund "$pnpm_package"
  fi
  uv tool install rust-just
  uv tool install prek==0.5.2
}

step 'System dependencies' system_dependencies
step 'CPU-only Xwayland with native input emulation' xwayland
step 'Toolchains and check runners' toolchains
step 'JavaScript dependencies' pnpm install --frozen-lockfile
step 'Rust dependency cache' cargo fetch --locked
step 'Embedded browser assets' just build-web
step 'Desktop service binaries' cargo build --locked --workspace
step 'Pre-commit hook environments' prek install-hooks
