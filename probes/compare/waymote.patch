+++ b/CursorCapture.zig
@@ -0,0 +1,434 @@
+//! Captures the compositor's hardware cursor through ext-image-copy-capture-v1.
+
+const CursorCapture = @This();
+
+const std = @import("std");
+const wayland = @import("wayland");
+
+const wl = wayland.client.wl;
+const ext = wayland.client.ext;
+const log = std.log.scoped(.stream_cursor);
+
+const protocol_version = 2;
+const cursor_image_event = 4;
+const cursor_visibility_event = 5;
+const maximum_dimension = 256;
+const bytes_per_pixel = 4;
+
+const Hotspot = struct {
+    x: i32 = 0,
+    y: i32 = 0,
+};
+
+allocator: std.mem.Allocator,
+io: std.Io,
+seat: ?*wl.Seat = null,
+shm: ?*wl.Shm = null,
+source_manager: ?*ext.OutputImageCaptureSourceManagerV1 = null,
+capture_manager: ?*ext.ImageCopyCaptureManagerV1 = null,
+cursor_session: ?*ext.ImageCopyCaptureCursorSessionV1 = null,
+session: ?*ext.ImageCopyCaptureSessionV1 = null,
+frame: ?*ext.ImageCopyCaptureFrameV1 = null,
+buffer: ?*wl.Buffer = null,
+mapping: ?[]align(std.heap.page_size_min) u8 = null,
+width: u32 = 0,
+height: u32 = 0,
+format: ?wl.Shm.Format = null,
+has_pointer: bool = false,
+collecting_constraints: bool = false,
+batch_width: ?u32 = null,
+batch_height: ?u32 = null,
+batch_has_argb8888: bool = false,
+pending_hotspot: Hotspot = .{},
+committed_hotspot: Hotspot = .{},
+visibility: ?bool = null,
+force_image_publication: bool = true,
+published_pixels: ?[]u8 = null,
+published_width: u32 = 0,
+published_height: u32 = 0,
+published_hotspot: Hotspot = .{},
+frame_transform_received: bool = false,
+started: bool = false,
+failed: bool = false,
+
+pub fn init(allocator: std.mem.Allocator, io: std.Io) CursorCapture {
+    return .{ .allocator = allocator, .io = io };
+}
+
+pub fn bindGlobal(
+    self: *CursorCapture,
+    registry: *wl.Registry,
+    name: u32,
+    interface: []const u8,
+    version: u32,
+) !void {
+    if (std.mem.eql(u8, interface, std.mem.span(wl.Seat.interface.name))) {
+        if (self.seat == null) {
+            const seat = try registry.bind(
+                name,
+                wl.Seat,
+                @min(version, wl.Seat.generated_version),
+            );
+            self.seat = seat;
+            seat.setListener(*CursorCapture, seatListener, self);
+        }
+    } else if (std.mem.eql(u8, interface, std.mem.span(wl.Shm.interface.name))) {
+        if (self.shm == null) self.shm = try registry.bind(name, wl.Shm, 1);
+    } else if (std.mem.eql(
+        u8,
+        interface,
+        std.mem.span(ext.OutputImageCaptureSourceManagerV1.interface.name),
+    )) {
+        if (self.source_manager == null) {
+            self.source_manager = try registry.bind(
+                name,
+                ext.OutputImageCaptureSourceManagerV1,
+                1,
+            );
+        }
+    } else if (std.mem.eql(
+        u8,
+        interface,
+        std.mem.span(ext.ImageCopyCaptureManagerV1.interface.name),
+    )) {
+        if (self.capture_manager == null) {
+            self.capture_manager = try registry.bind(name, ext.ImageCopyCaptureManagerV1, 1);
+        }
+    }
+}
+
+pub fn start(self: *CursorCapture, output: *wl.Output) !void {
+    if (self.started) return error.CursorCaptureAlreadyStarted;
+    const source_manager = self.source_manager orelse return error.MissingCursorSourceManager;
+    const capture_manager = self.capture_manager orelse return error.MissingCursorCaptureManager;
+    const seat = self.seat orelse return error.MissingCursorSeat;
+    _ = self.shm orelse return error.MissingCursorShm;
+    if (!self.has_pointer) return error.MissingPointerCapability;
+
+    const source = try source_manager.createSource(output);
+    defer source.destroy();
+    const pointer = try seat.getPointer();
+    defer releasePointer(pointer);
+    const cursor_session = try capture_manager.createPointerCursorSession(source, pointer);
+    errdefer cursor_session.destroy();
+    const session = try cursor_session.getCaptureSession();
+    errdefer session.destroy();
+
+    cursor_session.setListener(*CursorCapture, cursorSessionListener, self);
+    session.setListener(*CursorCapture, sessionListener, self);
+    self.cursor_session = cursor_session;
+    self.session = session;
+    self.started = true;
+}
+
+pub fn deinit(self: *CursorCapture) void {
+    self.destroyFrame();
+    self.destroyBuffer();
+    if (self.published_pixels) |pixels| self.allocator.free(pixels);
+    if (self.session) |session| session.destroy();
+    if (self.cursor_session) |session| session.destroy();
+    if (self.capture_manager) |manager| manager.destroy();
+    if (self.source_manager) |manager| manager.destroy();
+    if (self.shm) |shm| shm.destroy();
+    if (self.seat) |seat| {
+        if (seat.getVersion() >= wl.Seat.release_since_version) {
+            seat.release();
+        } else {
+            seat.destroy();
+        }
+    }
+    self.* = undefined;
+}
+
+fn releasePointer(pointer: *wl.Pointer) void {
+    if (pointer.getVersion() >= wl.Pointer.release_since_version) {
+        pointer.release();
+    } else {
+        pointer.destroy();
+    }
+}
+
+fn beginConstraintBatch(self: *CursorCapture) void {
+    if (self.collecting_constraints) return;
+    self.collecting_constraints = true;
+    self.batch_width = null;
+    self.batch_height = null;
+    self.batch_has_argb8888 = false;
+}
+
+fn applyConstraints(self: *CursorCapture) !void {
+    if (!self.collecting_constraints) return error.MissingCursorBufferConstraints;
+    self.collecting_constraints = false;
+    const width = self.batch_width orelse return error.MissingCursorBufferSize;
+    const height = self.batch_height orelse return error.MissingCursorBufferSize;
+    if (!self.batch_has_argb8888) return error.UnsupportedCursorPixelFormat;
+
+    self.destroyFrame();
+    self.destroyBuffer();
+    try self.ensureBuffer(width, height, .argb8888);
+    try self.requestFrame();
+}
+
+fn ensureBuffer(
+    self: *CursorCapture,
+    width: u32,
+    height: u32,
+    format: wl.Shm.Format,
+) !void {
+    const byte_count = try cursorByteCount(width, height);
+    if (format != .argb8888) return error.UnsupportedCursorPixelFormat;
+    if (self.buffer != null and self.width == width and self.height == height and
+        self.format == format) return;
+
+    self.destroyBuffer();
+    const fd = try std.posix.memfd_create("waymote-cursor", std.os.linux.MFD.CLOEXEC);
+    const file: std.Io.File = .{ .handle = fd, .flags = .{ .nonblocking = false } };
+    defer file.close(self.io);
+    try file.setLength(self.io, byte_count);
+    const mapping = try std.posix.mmap(
+        null,
+        byte_count,
+        .{ .READ = true, .WRITE = true },
+        .{ .TYPE = .SHARED },
+        fd,
+        0,
+    );
+    errdefer std.posix.munmap(mapping);
+    const pool = try self.shm.?.createPool(fd, @intCast(byte_count));
+    defer pool.destroy();
+    const buffer = try pool.createBuffer(
+        0,
+        @intCast(width),
+        @intCast(height),
+        @intCast(width * bytes_per_pixel),
+        format,
+    );
+    self.mapping = mapping;
+    self.buffer = buffer;
+    self.width = width;
+    self.height = height;
+    self.format = format;
+}
+
+fn destroyBuffer(self: *CursorCapture) void {
+    if (self.buffer) |buffer| buffer.destroy();
+    self.buffer = null;
+    if (self.mapping) |mapping| std.posix.munmap(mapping);
+    self.mapping = null;
+    self.width = 0;
+    self.height = 0;
+    self.format = null;
+}
+
+fn requestFrame(self: *CursorCapture) !void {
+    std.debug.assert(self.frame == null);
+    const session = self.session orelse return error.MissingCursorCaptureSession;
+    const buffer = self.buffer orelse return error.MissingCursorBuffer;
+    const frame = try session.createFrame();
+    self.frame = frame;
+    self.frame_transform_received = false;
+    frame.setListener(*CursorCapture, frameListener, self);
+    frame.attachBuffer(buffer);
+    frame.damageBuffer(0, 0, @intCast(self.width), @intCast(self.height));
+    frame.capture();
+}
+
+fn destroyFrame(self: *CursorCapture) void {
+    if (self.frame) |frame| frame.destroy();
+    self.frame = null;
+    self.frame_transform_received = false;
+}
+
+fn retryFrame(self: *CursorCapture) !void {
+    self.destroyFrame();
+    if (self.collecting_constraints) return;
+    const width = self.width;
+    const height = self.height;
+    const format = self.format orelse return error.MissingCursorBufferConstraints;
+    self.destroyBuffer();
+    try self.ensureBuffer(width, height, format);
+    try self.requestFrame();
+}
+
+fn frameReady(self: *CursorCapture) !void {
+    if (self.failed) {
+        self.destroyFrame();
+        return;
+    }
+    if (!self.frame_transform_received) return error.MissingCursorTransform;
+    self.destroyFrame();
+    self.committed_hotspot = self.pending_hotspot;
+    try self.publishImage();
+    try self.requestFrame();
+}
+
+fn publishImage(self: *CursorCapture) !void {
+    const pixels = self.mapping orelse return error.MissingCursorBuffer;
+    const byte_count = try cursorByteCount(self.width, self.height);
+    if (pixels.len != byte_count) return error.InvalidCursorBuffer;
+
+    const changed = self.published_pixels == null or
+        self.published_width != self.width or
+        self.published_height != self.height or
+        !std.meta.eql(self.published_hotspot, self.committed_hotspot) or
+        !std.mem.eql(u8, self.published_pixels.?, pixels);
+    if (!changed and !self.force_image_publication) return;
+
+    const replacement = if (changed) try self.allocator.dupe(u8, pixels) else null;
+    errdefer if (replacement) |owned| self.allocator.free(owned);
+    var metadata: [16]u8 = undefined;
+    encodeImageMetadata(&metadata, self.width, self.height, self.committed_hotspot);
+    try self.writeEvent(cursor_image_event, &.{ &metadata, pixels });
+
+    if (replacement) |owned| {
+        if (self.published_pixels) |old| self.allocator.free(old);
+        self.published_pixels = owned;
+        self.published_width = self.width;
+        self.published_height = self.height;
+        self.published_hotspot = self.committed_hotspot;
+    }
+    self.force_image_publication = false;
+}
+
+fn publishVisibility(self: *CursorCapture, visible: bool) !void {
+    if (self.visibility != null and self.visibility.? == visible) return;
+    const payload = [1]u8{@intFromBool(visible)};
+    try self.writeEvent(cursor_visibility_event, &.{&payload});
+    self.visibility = visible;
+}
+
+fn writeEvent(self: *CursorCapture, event_type: u8, parts: []const []const u8) !void {
+    var payload_length: usize = 0;
+    for (parts) |part| payload_length = std.math.add(usize, payload_length, part.len) catch
+        return error.CursorEventTooLarge;
+    if (payload_length > std.math.maxInt(u32)) return error.CursorEventTooLarge;
+
+    var header: [8]u8 = @splat(0);
+    header[0] = protocol_version;
+    header[1] = event_type;
+    std.mem.writeInt(u32, header[4..8], @intCast(payload_length), .little);
+    const output = std.Io.File.stdout();
+    try output.writeStreamingAll(self.io, &header);
+    for (parts) |part| try output.writeStreamingAll(self.io, part);
+}
+
+fn cursorByteCount(width: u32, height: u32) !usize {
+    if (width == 0 or height == 0 or width > maximum_dimension or height > maximum_dimension) {
+        return error.InvalidCursorDimensions;
+    }
+    const pixels = std.math.mul(usize, width, height) catch return error.CursorBufferOverflow;
+    return std.math.mul(usize, pixels, bytes_per_pixel) catch return error.CursorBufferOverflow;
+}
+
+fn encodeImageMetadata(
+    metadata: *[16]u8,
+    width: u32,
+    height: u32,
+    hotspot: Hotspot,
+) void {
+    std.mem.writeInt(u32, metadata[0..4], width, .little);
+    std.mem.writeInt(u32, metadata[4..8], height, .little);
+    std.mem.writeInt(i32, metadata[8..12], hotspot.x, .little);
+    std.mem.writeInt(i32, metadata[12..16], hotspot.y, .little);
+}
+
+fn fail(self: *CursorCapture, err: anyerror) void {
+    if (self.failed) return;
+    self.failed = true;
+    log.err("cursor capture failed: {t}", .{err});
+}
+
+fn seatListener(_: *wl.Seat, event: wl.Seat.Event, self: *CursorCapture) void {
+    switch (event) {
+        .capabilities => |capabilities| self.has_pointer = capabilities.capabilities.pointer,
+        .name => {},
+    }
+}
+
+fn cursorSessionListener(
+    _: *ext.ImageCopyCaptureCursorSessionV1,
+    event: ext.ImageCopyCaptureCursorSessionV1.Event,
+    self: *CursorCapture,
+) void {
+    switch (event) {
+        .enter => {
+            self.force_image_publication = true;
+            self.publishVisibility(true) catch |err| self.fail(err);
+        },
+        .leave => self.publishVisibility(false) catch |err| self.fail(err),
+        .position => {},
+        .hotspot => |hotspot| self.pending_hotspot = .{ .x = hotspot.x, .y = hotspot.y },
+    }
+}
+
+fn sessionListener(
+    _: *ext.ImageCopyCaptureSessionV1,
+    event: ext.ImageCopyCaptureSessionV1.Event,
+    self: *CursorCapture,
+) void {
+    switch (event) {
+        .buffer_size => |size| {
+            self.beginConstraintBatch();
+            self.batch_width = size.width;
+            self.batch_height = size.height;
+        },
+        .shm_format => |format| {
+            self.beginConstraintBatch();
+            if (format.format == .argb8888) self.batch_has_argb8888 = true;
+        },
+        .dmabuf_device, .dmabuf_format => self.beginConstraintBatch(),
+        .done => self.applyConstraints() catch |err| self.fail(err),
+        .stopped => {
+            self.destroyFrame();
+            if (self.session) |session| session.destroy();
+            self.session = null;
+            self.fail(error.CursorCaptureStopped);
+        },
+    }
+}
+
+fn frameListener(
+    _: *ext.ImageCopyCaptureFrameV1,
+    event: ext.ImageCopyCaptureFrameV1.Event,
+    self: *CursorCapture,
+) void {
+    switch (event) {
+        .transform => |transform| {
+            self.frame_transform_received = true;
+            if (transform.transform != .normal) self.fail(error.UnsupportedCursorTransform);
+        },
+        .ready => self.frameReady() catch |err| self.fail(err),
+        .failed => |failed| switch (failed.reason) {
+            .buffer_constraints => self.retryFrame() catch |err| self.fail(err),
+            .unknown => {
+                self.destroyFrame();
+                self.fail(error.CursorFrameFailed);
+            },
+            .stopped => {
+                self.destroyFrame();
+                self.fail(error.CursorCaptureStopped);
+            },
+            else => {
+                self.destroyFrame();
+                self.fail(error.CursorFrameFailed);
+            },
+        },
+        .damage, .presentation_time => {},
+    }
+}
+
+test "cursor dimensions are bounded and produce exact BGRA lengths" {
+    try std.testing.expectEqual(@as(usize, 4), try cursorByteCount(1, 1));
+    try std.testing.expectEqual(@as(usize, 256 * 256 * 4), try cursorByteCount(256, 256));
+    try std.testing.expectError(error.InvalidCursorDimensions, cursorByteCount(0, 1));
+    try std.testing.expectError(error.InvalidCursorDimensions, cursorByteCount(257, 1));
+}
+
+test "cursor image metadata uses little-endian signed hotspots" {
+    var metadata: [16]u8 = undefined;
+    encodeImageMetadata(&metadata, 32, 24, .{ .x = -3, .y = 7 });
+    try std.testing.expectEqual(@as(u32, 32), std.mem.readInt(u32, metadata[0..4], .little));
+    try std.testing.expectEqual(@as(u32, 24), std.mem.readInt(u32, metadata[4..8], .little));
+    try std.testing.expectEqual(@as(i32, -3), std.mem.readInt(i32, metadata[8..12], .little));
+    try std.testing.expectEqual(@as(i32, 7), std.mem.readInt(i32, metadata[12..16], .little));
+}
