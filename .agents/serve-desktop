#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
: "${PORT:?Start with amp orb services ensure}"
: "${PUBLIC_URL:?Amp must supply the portal origin}"

# Reuse snapshot build artifacts; pick up source changes on service restart.
just build-web
cargo build --locked --workspace

export XDG_RUNTIME_DIR="$HOME/.cache/waywire-orb"
install -d -m 0700 "$XDG_RUNTIME_DIR"
unset WAYLAND_DISPLAY DISPLAY
export PATH="${WAYWIRE_XWAYLAND_PREFIX:-$HOME/.local/share/waywire-xwayland}/bin:$PATH"

# The gateway owns the compositor, which supplies the display to its application.
# Amp supervises the whole session; this is separate from Amp's bundled Desktop.
exec dbus-run-session -- ./target/debug/waywire-gateway \
  --listen "127.0.0.1:$PORT" --compositor ./target/debug/waywire-compositor \
  -- foot --title="Waywire"
