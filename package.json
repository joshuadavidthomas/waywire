{
  "name": "sprite-desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:rust": "pnpm --filter @sprite-desktop/stream-viewer build && cargo build --release --workspace",
    "check": "pnpm -r --if-present check",
    "check:rust": "pnpm --filter @sprite-desktop/stream-viewer check && pnpm --filter @sprite-desktop/stream-viewer test && pnpm --filter @sprite-desktop/stream-viewer build && cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace && tsx --test probes/rust-desktop/*.test.ts",
    "test:rust:ipc": "pnpm --filter @sprite-desktop/stream-viewer build && cargo build -p sprite-desktop-gateway && tsx probes/rust-desktop/ipc-check.ts --gateway target/debug/sprite-desktop-gateway",
    "test:rust:media": "cargo test -p sprite-desktop-streamd ffmpeg_ -- --ignored",
    "dev": "pnpm --parallel --filter @sprite-desktop/web --filter @sprite-desktop/gateway dev",
    "dev:web": "pnpm --filter @sprite-desktop/web dev",
    "dev:gateway": "pnpm --filter @sprite-desktop/gateway dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "provision": "pnpm --filter @sprite-desktop/provision provision",
    "install-desktop": "tsx packages/sprite-provision/src/install.ts",
    "release": "tsx scripts/build-release.ts",
    "setup:local": "tsx scripts/setup-local.ts",
    "test": "pnpm -r --if-present test",
    "tunnel": "tsx scripts/tunnel-sanity.ts",
    "typegen": "pnpm -r --if-present typegen"
  },
  "devDependencies": {
    "@fly/sprites": "0.2.2",
    "@types/node": "^24.13.3",
    "@types/semver": "7.8.0",
    "@types/ws": "8.18.1",
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "3.4.0",
    "semver": "7.8.5",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "ws": "8.19.0"
  }
}
