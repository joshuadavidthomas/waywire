#!/usr/bin/env bash
set -euo pipefail

sudo env DEBIAN_FRONTEND=noninteractive apt-get update
sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
  ca-certificates curl

sudo install -d -m 0755 /etc/apt/keyrings
curl -fsSL https://packages.mozilla.org/apt/repo-signing-key.gpg \
  | sudo tee /etc/apt/keyrings/packages.mozilla.org.asc > /dev/null
sudo chmod 0644 /etc/apt/keyrings/packages.mozilla.org.asc
sudo tee /etc/apt/sources.list.d/mozilla.list > /dev/null <<'APT'
deb [signed-by=/etc/apt/keyrings/packages.mozilla.org.asc] https://packages.mozilla.org/apt mozilla main
APT
sudo tee /etc/apt/preferences.d/mozilla > /dev/null <<'APT'
Package: firefox
Pin: origin packages.mozilla.org
Pin-Priority: 1001
APT

sudo env DEBIAN_FRONTEND=noninteractive apt-get update
sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
  ca-certificates curl dbus-x11 ffmpeg fonts-dejavu-core labwc lxqt-core \
  lxqt-menu-data lxqt-wayland-session featherpad breeze-cursor-theme \
  breeze-icon-theme qt6-svg-plugins qt6-wayland python3 xdg-utils firefox
