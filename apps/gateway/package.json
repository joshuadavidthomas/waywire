{
  "name": "@sprite-desktop/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --port 8788",
    "dev:remote": "wrangler dev --remote --port 8788",
    "test": "vitest run",
    "typegen": "wrangler types --env-file .dev.vars.example"
  },
  "dependencies": {
    "@sprite-desktop/shared": "workspace:*"
  },
  "devDependencies": {
    "vitest": "5.0.0",
    "wrangler": "4.129.0"
  }
}
