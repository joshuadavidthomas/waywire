+            );
+            capture.cancel();
+            start(&mut capture, &objects);
+            configure(&mut capture, &objects);
+        }
+        capture.request(&objects.qh).unwrap();
+        assert!(
+            capture
+                .failed(WEnum::Value(
+                    ext_image_copy_capture_frame_v1::FailureReason::BufferConstraints,
+                ))
